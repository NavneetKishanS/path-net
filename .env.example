# Copy to .env (`bash run.sh setup` does this). .env is git-ignored. Never commit keys.

# --- Pipeline (P1, P2) ---
OPENAI_API_KEY=
# Pick models your key can use. Small model for bulk extraction, stronger one for explanations.
OPENAI_MODEL_EXTRACT=
OPENAI_MODEL_EXPLAIN=
NCBI_EMAIL=
NCBI_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# --- Voice (P2 / P4) ---
ELEVENLABS_API_KEY=

# --- Pipeline outside Docker (docker-compose sets its own values) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/pathnet

# --- Web (only when running web/ by hand; docker-compose sets these) ---
# static = read data/seed/graph.json, rest = read the PostgREST API
VITE_DATA_SOURCE=static
VITE_API_URL=http://localhost:3001

# --- Supabase (operator scripts/Edge Functions; never prefix server keys VITE_) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated allowed browser origins for Edge Functions; confirm before deploy.
ALLOWED_ORIGINS=http://localhost:5173

# Five separate Auth identities; supply passwords locally, never commit real credentials.
# Provision only after migrations: python scripts/platform.py demo-users
DEMO_FAMILY_EMAIL=
DEMO_FAMILY_PASSWORD=
DEMO_GROUP_LEADER_EMAIL=
DEMO_GROUP_LEADER_PASSWORD=
DEMO_SCOUT_EMAIL=
DEMO_SCOUT_PASSWORD=
DEMO_RESEARCHER_EMAIL=
DEMO_RESEARCHER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
