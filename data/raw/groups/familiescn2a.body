.custom-back-to-top {
  position: fixed;
  bottom: 40px;
  right: 40px;
  background-color: #28c76f;
  color: white !important;
  padding: 12px 20px;
  border-radius: 6px;
  font-family: sans-serif;
  font-size: 16px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  z-index: 9999;
}

.custom-back-to-top span {
  color: white !important;
  font-weight:600;
}

.custom-back-to-top svg {
  width: 1em;
  height: 1em;
  fill: white !important;
}
.custom-back-to-top svg {
  width: 1em;
  height: 1em;
  fill: white !important;
}
.custom-back-to-top {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.custom-back-to-top.visible {
  opacity: 1;
  pointer-events: auto;
}

.modal-body a {
  color: #ffffff !important;
  font-weight: bold;
  text-decoration: underline;
}</style>
