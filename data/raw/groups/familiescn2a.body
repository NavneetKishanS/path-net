<style id="wp-custom-css">
.e-search-submit:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}


.elementor-widget-search .e-search-results-container {
	display: none !important;}
</style>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const searchForm = document.querySelector(".e-search-form");
  if (!searchForm) return;

  const searchInput = searchForm.querySelector(".e-search-input");
  const searchBtn = searchForm.querySelector(".e-search-submit");

  if (searchInput && searchBtn) {
    // Disable button initially
    searchBtn.disabled = true;

    // Enable button only if there's input
    searchInput.addEventListener("input", function () {
      searchBtn.disabled = (this.value.trim() === "");
    });

    // Prevent submit on empty search
    searchForm.addEventListener("submit", function (e) {
      if (searchInput.value.trim() === "") {
        e.preventDefault();
      }
    });
  }
});
</script><a href="#wrap" class="custom-back-to-top" data-localscroll="true">
