    <main>            <section class="nord-layout layout-page-flexible-content"><div class="inner">
				<section class="fcl fcl-page-flexible-content-primary-hero theme-background-default no-mt no-mr no-mb no-ml xl-pt no-pr xl-pb no-pl is-light"
		         id="test-anchor"		         >
		    		    <div class="inner ">
	<div class="container">
    <div class="row align-items-center">
        <div class="col-lg-6">
			                <p class="pre-headline theme-color-secondary h5 mb-0">Soaring with SCN2A </p>
						                <h2 class="headline h1 med-mt xs-mb theme-color-secondary-text">
					Join the Registry – Where Dragonflies Inspire Hope!                </h2>
			            <hr/>
			                <div class="large-text med-mb">
					<p>Welcome to The DRAGONFLY Study, a registry dedicated to individuals and families impacted by SCN2A-related disorders. This registry serves as a central hub for sharing patient experiences and contributing vital information to drive research forward. Join us in building a stronger, more informed community and making a lasting impact on the understanding and treatment of SCN2A-related disorders.</p>
<p>For more information about how to register, <a href="https://scn2a.iamrare.org/about/how-to-register/" data-wpel-link="internal">click here</a>.</p>
                </div>
						        </div>
        <div class="col-lg-5 offset-lg-1 text-center">
                            <div class="hero-icon">
                    <img width="525" height="525" src="https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-525x525.png" class="" alt="" decoding="async" fetchpriority="high" srcset="https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-525x525.png 525w, https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-300x300.png 300w, https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-1024x1024.png 1024w, https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-150x150.png 150w, https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-768x768.png 768w, https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image-195x195.png 195w, https://scn2a.iamrare.org/wp-content/uploads/sites/52/2024/07/Hero-Image.png 1080w" sizes="(max-width: 525px) 100vw, 525px" />                </div>
                    </div>
    </div>
</div>

	</div></section>

			<section class="fcl fcl-page-flexible-content-columns-funnel theme-background-default no-mt no-mr no-mb no-ml xxl-pt no-pr xxl-pb no-pl is-light"
		         		         >
		    		    <div class="inner ">
	<div class="container container-offset">
	<div class="row">
		            <div class="lg-mb col-lg-6">
				<div class="callout-box">
                                            <div class="icon">
                            <i class="fa-thin fa-nfc-magnifying-glass"></i>
                        </div>
                    
											<p class="pre-headline xs-mb h4 ff-body theme-color-secondary">For Researchers</p>
																<h2 class="mt-0 sm-mb">Drive Research</h2>
																<div class="description med-mb"><p>This is a unique rare disease patient registry. Are you interested in using our data to further your rare disease research?</p>
</div>
																<div class="button-wrapper">
                            <a href="https://scn2a.iamrare.org/about/for-researchers/" target="" class="button" data-wpel-link="internal">Learn More</a>
                        </div>
