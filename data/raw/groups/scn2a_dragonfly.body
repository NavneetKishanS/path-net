(function () {
    // Only iamrare.org hosts can receive this cookie. Elsewhere (nordregistry.com,
    // which this theme also serves) the browser rejects it as a cross-domain write.
    if (!/(^|\.)iamrare\.org$/.test(window.location.hostname)) {
        return;
    }

    // Supported languages keyed by path segment. Add new languages here.
    // Values are the culture codes app.iamrare.org expects.
    var LANGS = { fr: 'fr', es: 'es' };
    var DEFAULT_LANG = 'en';

    var base = "\/";
    var path = window.location.pathname;

    function firstSegment(p) {
        return (p.split('/')[1] || '').toLowerCase();
    }

    // On subdomain subsites the language is the first segment. On a subdirectory
    // subsite it sits just after the subsite base path. Check both positions and
    // take the first that is a known language, so neither layout can mask the other.
    var candidates = [firstSegment(path)];
    if (base !== '/' && path.indexOf(base) === 0) {
        candidates.push(firstSegment(path.slice(base.length - 1)));
    }

    var lang = DEFAULT_LANG;
    for (var i = 0; i < candidates.length; i++) {
        if (LANGS[candidates[i]]) {
            lang = LANGS[candidates[i]];
            break;
        }
    }

    // ASP.NET Core's CookieRequestCultureProvider parses this by splitting on '|'
    // and '=' and does not URL-decode, so the value must be written unencoded.
    var value = 'c=' + lang + '|uic=' + lang;

    document.cookie = '.AspNetCore.Culture=' + value +
        '; domain=iamrare.org' +
        '; path=/' +
        '; max-age=604800' +
        '; samesite=lax' +
        (window.location.protocol === 'https:' ? '; secure' : '');

    // Opt-in diagnostics: append ?langdebug=1 to any URL to see what was detected.
    if (window.location.search.indexOf('langdebug=1') !== -1) {
        console.log('[lang] pathname=' + window.location.pathname +
            ' base=' + base +
            ' candidates=' + JSON.stringify(candidates) +
            ' -> ' + value);
        console.log('[lang] document.cookie=' + document.cookie);
    }
})();
</script>
