<style id="wp-custom-css">

.fl-theme-builder-header-scrolled .fl-node-5c5a5e803d63e {
	display: none;	
}


@media (min-width:768px){
	.fl-node-5c5a5e803d63d .menu .fl-has-submenu .sub-menu {
		border-top: 3px solid #c0a7d0;
	}
}

.fl-subscribe-form .fl-form-field input[type=text],
.fl-subscribe-form .fl-form-field input[type=email]{
	border-radius: 0px !important;
	border-width: 0px;
	line-height: 1.5 !important;
}

/*
.fl-menu .fl-menu-mobile-toggle.hamburger{
	background-color: #c0a7d0; 
}

@media (max-width: 992px){
		 .fl-menu .sub-menu {
			 padding-left:20px;
	}
}
*/

.fl-content-slider .fl-content-slider-navigation{
	opacity: 0;
	transition: all 200ms ease;
}
.fl-content-slider:hover .fl-content-slider-navigation{
	opacity: 1;
}


.goog-te-combo{
	color: #c0a7d0;
}
/* Equal height cards for UABB Team module */
.team-equal .uabb-team-member,
.team-equal .uabb-team-member-wrapper,
.team-equal .uabb-team-wrap,
.team-equal .uabb-team {
  height: 100%;
}

.team-equal .uabb-team-wrap {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: stretch !important;
}

/* Each member card becomes a flex column so content can stretch evenly */
.team-equal .uabb-team-wrap .uabb-team-member,
.team-equal .uabb-team-wrap .uabb-team-member-wrapper {
  display: flex !important;
  flex-direction: column !important;
}

/* The content area expands so buttons or socials align consistently */
.team-equal .uabb-team-content,
.team-equal .uabb-team-info,
.team-equal .uabb-team-desc {
  flex: 1 1 auto !important;
}
.tribe-events-c-nav__next,
.tribe-events-c-nav__prev,
.tribe-events-c-nav__next:hover,
.tribe-events-c-nav__prev:hover {
  color: #5B407C;
}

.tribe-common-c-btn-border {
  border-color: #5B407C;
  color: #5B407C;
}

.tribe-common-c-btn-border:hover {
  background-color: #5B407C;
  color: #ffffff;
}

a.tribe-event-url {
  color: #5B407C;
}

a.tribe-event-url:hover {
  color: #E66224;
}
/* Events list layout */
.tribe-events-calendar-list__event-row {
  border-bottom: 1px solid #e0e0e0;
  padding: 20px 0;
}

/* Date styling */
.tribe-events-calendar-list__event-datetime {
  color: #5B407C;
  font-weight: bold;
}

/* Event title */
.tribe-events-calendar-list__event-title a {
  color: #5B407C;
  text-decoration: none;
}

.tribe-events-calendar-list__event-title a:hover {
  color: #E66224;
}

/* Virtual event label */
.tribe-events-virtual-venue-link {
  color: #E66224;
  font-weight: bold;
}

/* Navigation buttons */
.tribe-events-c-nav__next,
.tribe-events-c-nav__prev {
  color: #5B407C;
  border-color: #5B407C;
}

.tribe-events-c-nav__next:hover,
.tribe-events-c-nav__prev:hover {
  color: #E66224;
  border-color: #E66224;
}

/* Section headings like "Upcoming Events" */
.tribe-events-header__title {
  color: #5B407C;
  font-size: 24px;
}
.fe-edit-set {
  display: none !important;
}
#callout-row .fl-col-content {
  display: flex;
  flex-direction: column;
  height: 100%;
}

#callout-row .fl-module-callout {
  display: flex;
  flex-direction: column;
  flex: 1;
}

#callout-row .fl-module-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

#callout-row .fl-callout {
  display: flex;
  flex-direction: column;
  flex: 1;
}

#callout-row .fl-callout-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}
/* Style the heading */
.menu-heading > a {
    color: #E66224 !important;
    cursor: default;
    pointer-events: none;
}



</style>
