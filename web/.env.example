# Existing graph adapters remain supported.
NEXT_PUBLIC_DATA_SOURCE=rest
NEXT_PUBLIC_API_URL=http://localhost:3001

# Additive native account service for the local PostgreSQL demo.
# This variable MUST stay server-only (never use NEXT_PUBLIC_ for database credentials).
# Fresh clones do not need to copy this file: npm run dev generates local configuration.
# npm run dev provisions this Docker database automatically when no account URL is configured.
# For an existing database, replace this URL with its server-only connection string.
PATHNET_ACCOUNT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/pathnet?sslmode=disable
# Generated setups add PATHNET_ACCOUNT_LOCAL=true to restart their Docker stack on later runs.
# Keep it unset or false when configuring an existing database yourself.
# PATHNET_ACCOUNT_LOCAL=false
# Use the same graph tables through a same-origin session-aware RLS proxy.
NEXT_PUBLIC_ACCOUNT_PROXY=true
# Set only when an operator has configured a trustworthy reverse proxy.
PATHNET_ACCOUNT_TRUST_PROXY=false
# Optional: disable automatic database preparation for guest-only or externally managed startup.
# PATHNET_ACCOUNT_BOOTSTRAP=false
